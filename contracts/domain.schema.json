{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "脑控康复安全决策账领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "CONSENT_RECORDED",
        "CONSENT_WITHDRAWN",
        "STAFF_REGISTERED",
        "VENUE_REGISTERED",
        "DEVICE_STATUS_REPORTED",
        "PROFILE_APPROVED",
        "BASELINE_SET",
        "CASE_OPENED",
        "SESSION_BOOKED",
        "SUMMARY_ACCEPTED",
        "SUMMARY_QUARANTINED",
        "DECISION_RECORDED",
        "TRAINING_PAUSED",
        "TRAINING_RESUMED",
        "SESSION_HELD",
        "FOLLOWUP_DUE",
        "REVIEW_SIGNED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "patient_consent",
        "device_profile",
        "training_baseline",
        "training_case",
        "training_session",
        "venue_profile",
        "staff_roster",
        "safety_review"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "payload_required_by_event": {
    "CONSENT_WITHDRAWN": [
      "requested_by"
    ],
    "STAFF_REGISTERED": [
      "role"
    ],
    "VENUE_REGISTERED": [
      "capacity",
      "condition"
    ],
    "DEVICE_STATUS_REPORTED": [
      "device_revision",
      "decoder_version",
      "reporter_id"
    ],
    "PROFILE_APPROVED": [
      "device_revision",
      "reviewer_id"
    ],
    "BASELINE_SET": [
      "baseline_version",
      "therapist_id"
    ],
    "CASE_OPENED": [
      "patient_id",
      "device_revision",
      "decoder_version",
      "baseline_version"
    ],
    "SESSION_BOOKED": [
      "case_id",
      "therapist_id",
      "venue_id",
      "start",
      "end"
    ],
    "SUMMARY_ACCEPTED": [
      "session_id",
      "decoder_version",
      "fingerprint"
    ],
    "SUMMARY_QUARANTINED": [
      "session_id",
      "decoder_version",
      "fingerprint",
      "reason"
    ],
    "DECISION_RECORDED": [
      "session_id",
      "decision",
      "evaluator_id"
    ],
    "TRAINING_PAUSED": [
      "reason",
      "paused_by"
    ],
    "TRAINING_RESUMED": [
      "confirmed_by",
      "conclusion"
    ],
    "SESSION_HELD": [
      "reason",
      "observed_at"
    ],
    "FOLLOWUP_DUE": [
      "case_id",
      "session_id",
      "due_at"
    ],
    "REVIEW_SIGNED": [
      "decision",
      "reviewer_id"
    ]
  },
  "additionalProperties": false
}
